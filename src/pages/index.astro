---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import authorPhoto from '../assets/dean-lee.jpg';
import { AUTHOR, COLUMNS, EPIGRAPH, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const essays = (await getCollection('essays')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = essays[0];
const recent = essays.slice(0, 4);

const papers = (await getCollection('papers')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const working = papers.filter((p) => p.data.status === 'working');
const published = papers.filter((p) => p.data.status === 'published');

const fmt = (d: Date) => d.toLocaleDateString('en-CA').replace(/-/g, '.');
---

<BaseLayout title={`${SITE_TITLE} - ${SITE_TAGLINE}`} description={SITE_DESCRIPTION}>
	<div class="wrap">
		<section class="hero">
			<div class="hero-copy">
				<p class="label">On the author</p>
				<p class="lede">{AUTHOR.bio}</p>
				<p class="vitals">Born {AUTHOR.born} / {AUTHOR.edu} / {AUTHOR.pronouns}</p>
				<blockquote class="epigraph">&ldquo;{EPIGRAPH}&rdquo;</blockquote>
				<div class="cta">
					<a class="btn gold" href="/essays">Latest essay</a>
					<a class="btn" href="/#newsletter">Subscribe</a>
				</div>
			</div>
			<figure class="portrait">
				<div class="portrait-frame">
					<Image
						src={authorPhoto}
						alt={AUTHOR.photoAlt}
						widths={[320, 480, 640, 800]}
						sizes="(max-width: 900px) 88vw, 420px"
						quality={82}
						class="portrait-img"
					/>
				</div>
				<figcaption class="portrait-cap">
					<span class="portrait-name">{AUTHOR.name}</span>
					<span class="portrait-meta">{AUTHOR.edu}</span>
				</figcaption>
			</figure>
		</section>

		<section class="sec" id="featured">
			<div class="sec-head">
				<div class="sec-kicker"><span class="sec-no">01</span><h2>Essay of the week</h2></div>
				<div class="rule"></div>
			</div>
			{
				featured ? (
					<a class="feature" href={`/essays/${featured.id}/`}>
						<div>
							<blockquote class="quote">&ldquo;{featured.data.description}&rdquo;</blockquote>
							<p class="byline">{fmt(featured.data.pubDate)}</p>
						</div>
						<div>
							<div class="num">No. {String(featured.data.number ?? 14).padStart(3, '0')} / Featured</div>
							<h3>{featured.data.title}</h3>
							<p>{featured.data.description}</p>
							<span class="btn">Continue reading -></span>
						</div>
					</a>
				) : (
					<div class="empty">
						No featured essay yet.<br />
						<span class="g">*</span> The first dispatch is being written.
					</div>
				)
			}
		</section>

		<section class="sec" id="papers">
			<div class="sec-head">
				<div class="sec-kicker"><span class="sec-no">02</span><h2>Papers</h2></div>
				<div class="rule"></div>
			</div>
			{
				papers.length > 0 ? (
					<div class="papers">
						<div>
							<h3>Working papers</h3>
							{working.map((p) => (
								<a class="paper" href={p.data.url ?? '#'}>
									<span class="st wp">WP / draft</span>
									<h4>{p.data.title}</h4>
									<p class="pv">{p.data.venue}</p>
								</a>
							))}
						</div>
						<div>
							<h3>Published</h3>
							{published.map((p) => (
								<a class="paper" href={p.data.url ?? '#'}>
									<span class="st">PUB</span>
									<h4>{p.data.title}</h4>
									<p class="pv">{p.data.venue}</p>
								</a>
							))}
						</div>
					</div>
				) : (
					<div class="empty">
						No papers catalogued yet.<br />
						<span class="g">*</span> Working drafts and published work will be listed here.
					</div>
				)
			}
		</section>

		<section class="sec" id="essays">
			<div class="sec-head">
				<div class="sec-kicker"><span class="sec-no">03</span><h2>Recent essays</h2></div>
				<div class="rule"></div>
			</div>
			{
				recent.length > 0 ? (
					<div class="essays">
						{recent.map((e) => (
							<a class="entry" href={`/essays/${e.id}/`}>
								<div class="no">{String(e.data.number ?? 0).padStart(2, '0')}</div>
								<div>
									{e.data.column && <div class="cat">{e.data.column}</div>}
									<h4>{e.data.title}</h4>
									<p>{e.data.description}</p>
								</div>
							</a>
						))}
					</div>
				) : (
					<div class="empty">
						No essays yet.<br />
						<span class="g">*</span> One careful dispatch, most weeks - once the first ships.
					</div>
				)
			}
			{
				recent.length > 0 && (
					<p class="section-more">
						<a class="btn" href="/essays">
							Full archive ->
						</a>
					</p>
				)
			}
		</section>

		<section class="sec" id="columns">
			<div class="sec-head">
				<div class="sec-kicker"><span class="sec-no">04</span><h2>Standing columns</h2></div>
				<div class="rule"></div>
			</div>
			<div class="columns">
				{
					COLUMNS.map((c) => (
						<a class="col" href="#">
							<div class="rn">{c.roman}.</div>
							<h4>{c.title}</h4>
							<p set:html={c.desc} />
						</a>
					))
				}
			</div>
		</section>

		<section class="sec sec-news" id="newsletter">
			<div class="news">
				<p class="label">The data, before the take</p>
				<h2>A weekly dispatch</h2>
				<p>
					One essay on pricing, markets, or the economics of AI - for people who like being argued with,
					gently. No price targets.
				</p>
				<form id="newsletter-form" class="newsletter-form">
					<label for="em" class="skip">Email</label>
					<input
						id="em"
						name="email"
						type="email"
						inputmode="email"
						autocomplete="email"
						spellcheck="false"
						placeholder="you@example.com"
						required
					/>
					<input name="website" class="skip" tabindex="-1" autocomplete="off" value="" />
					<button class="btn gold" type="submit" id="newsletter-btn">Subscribe</button>
				</form>
				<p class="fine" id="newsletter-msg">One click · Dean Lee essays only (not product mail) · unsubscribe anytime</p>
				<script is:inline>
					(function () {
						var form = document.getElementById('newsletter-form');
						if (!form) return;
						var btn = document.getElementById('newsletter-btn');
						var msg = document.getElementById('newsletter-msg');
						form.addEventListener('submit', function (e) {
							e.preventDefault();
							var email = (form.email && form.email.value || '').trim();
							if (!email) return;
							btn.disabled = true;
							msg.textContent = 'Subscribing…';
							fetch('https://mail.komoai.net:8443/api/subscribe', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({
									email: email,
									blog: 'dean',
									website: form.website ? form.website.value : '',
								}),
							})
								.then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
								.then(function (x) {
									if (x.ok && x.j && x.j.ok) {
										msg.textContent = "You're in. Thanks — no confirmation email needed.";
										form.reset();
									} else {
										msg.textContent = 'Could not subscribe. Check the address and try again.';
										btn.disabled = false;
									}
								})
								.catch(function () {
									msg.textContent = 'Network error. Try again in a moment.';
									btn.disabled = false;
								});
						});
					})();
				</script>
			</div>
		</section>
	</div>
</BaseLayout>
