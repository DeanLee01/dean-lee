---
import { NAV_LINKS, SITE_TAGLINE, SITE_TITLE, TOPLINE_TEXT } from '../consts';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---

<header class="site">
	<div class="wrap">
		<div class="topline">
			<span>{TOPLINE_TEXT}</span>
			<span class="r">
				<button class="theme-toggle" id="themeBtn" aria-label="Toggle light/dark">
					<span class="ico-sun" aria-hidden="true">LT</span>
					<span class="ico-moon" aria-hidden="true">DK</span>
				</button>
			</span>
		</div>
		<div class="masthead">
			<h1 class="title">{SITE_TITLE}</h1>
			<p class="tagline">{SITE_TAGLINE}</p>
		</div>
		<nav class="main" aria-label="Primary">
			{
				NAV_LINKS.map((link) => (
					<a href={link.href} class:list={[{ active: isActive(link.href) }]}>
						{link.label}
					</a>
				))
			}
			<a href="/#newsletter">Subscribe</a>
		</nav>
	</div>
</header>

<script is:inline>
	(function () {
		var root = document.documentElement;
		var key = 'dean-holloway-theme';
		var button = document.getElementById('themeBtn');
		if (!button) return;
		function sync() {
			button.setAttribute('aria-pressed', root.getAttribute('data-theme') === 'dark');
		}
		sync();
		button.addEventListener('click', function () {
			var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
			root.setAttribute('data-theme', next);
			localStorage.setItem(key, next);
			sync();
		});
	})();
</script>
