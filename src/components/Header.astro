---
import { NAV_LINKS, SITE_TAGLINE, SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
const isHome = pathname === '/';
---

<header class="site" data-home={isHome ? 'true' : 'false'}>
	<div class="wrap">
		<div class="bar">
			<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
				<span class="brand-mark" aria-hidden="true">D</span>
				<span class="brand-text">
					<span class="brand-name">{SITE_TITLE}</span>
					<span class="brand-tag">{SITE_TAGLINE}</span>
				</span>
			</a>

			<nav class="main" aria-label="Primary">
				{
					NAV_LINKS.map((link) => (
						<a href={link.href} class:list={[{ active: isActive(link.href) }]}>
							{link.label}
						</a>
					))
				}
				<a class="nav-cta" href="/#newsletter">Subscribe</a>
			</nav>

			<button class="theme-toggle" id="themeBtn" type="button" aria-label="Toggle light/dark">
				<span class="ico-sun" aria-hidden="true">Light</span>
				<span class="ico-moon" aria-hidden="true">Dark</span>
			</button>
		</div>
	</div>
</header>

<script is:inline>
	(function () {
		var root = document.documentElement;
		var key = 'dean-lee-theme';
		var button = document.getElementById('themeBtn');
		if (!button) return;
		function sync() {
			button.setAttribute('aria-pressed', root.getAttribute('data-theme') === 'dark');
		}
		sync();
		button.addEventListener('click', function () {
			var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
			root.setAttribute('data-theme', next);
			localStorage.setItem(key, next);
			sync();
		});
	})();
</script>
